# Exemplo de variáveis de ambiente do Conecta ETEC.
# Copie para .env (na raiz do repositório, em app/ ou em app/server/) e ajuste
# conforme necessário. O servidor carrega o primeiro .env encontrado, nesta ordem:
# app/server/.env, app/.env, .env na raiz. Variáveis já definidas no ambiente do
# processo têm precedência sobre o arquivo.
# O arquivo é opcional: sem ele, a aplicação usa os valores padrão.
# Nenhum segredo real deve ser versionado.

# Porta HTTP do servidor (padrão: 4000)
PORT=4000

# Caminho do banco SQLite. Padrão: <diretório de execução>/data/conectaetec.db
# Em app/server o padrão equivale a app/server/data/conectaetec.db.
DB_PATH=

# Diretório base de dados. Padrão: <diretório de execução>/data
DATA_DIR=

# Diretório de uploads. Padrão: <diretório de execução>/data/uploads
UPLOAD_DIR=

# Origem liberada no CORS (padrão: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Ambiente de execução (development, test ou production).
# Em production os cookies de sessão passam a ser seguros.
NODE_ENV=development

# Força a execução do seed de demonstração quando definido como 1.
# Sem essa variável, o seed roda sempre que NODE_ENV não for production.
SEED_DEMO=0
